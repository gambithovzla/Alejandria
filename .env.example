# Shared
NOVEL_ENGINE_ENV=development

# API
NOVEL_ENGINE_API_HOST=0.0.0.0
NOVEL_ENGINE_API_PORT=8000
NOVEL_ENGINE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novel_engine
NOVEL_ENGINE_CORS_ORIGINS=http://localhost:3000
NOVEL_ENGINE_LLM_PROVIDER=router
NOVEL_ENGINE_LLM_MODEL=
NOVEL_ENGINE_LLM_ALLOW_MOCK_FALLBACK=true
NOVEL_ENGINE_MOCK_LLM_MODEL=novel-engine-mock
NOVEL_ENGINE_LLM_TIMEOUT_SECONDS=60

# Recommended per-pipeline routing
NOVEL_ENGINE_LLM_SCENE_PLANNING_PROVIDER=openai
NOVEL_ENGINE_LLM_SCENE_PLANNING_MODEL=gpt-5.4-mini
NOVEL_ENGINE_LLM_SCENE_WRITING_PROVIDER=anthropic
NOVEL_ENGINE_LLM_SCENE_WRITING_MODEL=claude-sonnet-4-6
NOVEL_ENGINE_LLM_TECHNICAL_AUDIT_PROVIDER=openai
NOVEL_ENGINE_LLM_TECHNICAL_AUDIT_MODEL=gpt-5.4
NOVEL_ENGINE_LLM_LITERARY_AUDIT_PROVIDER=anthropic
NOVEL_ENGINE_LLM_LITERARY_AUDIT_MODEL=claude-opus-4-7
NOVEL_ENGINE_LLM_ADVERSARIAL_AUDIT_PROVIDER=openai
NOVEL_ENGINE_LLM_ADVERSARIAL_AUDIT_MODEL=gpt-5.4
NOVEL_ENGINE_LLM_KIMI_DEFAULT_MODEL=kimi-k2.6

# Provider credentials
NOVEL_ENGINE_OPENAI_API_KEY=
NOVEL_ENGINE_OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_ENGINE_ANTHROPIC_API_KEY=
NOVEL_ENGINE_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NOVEL_ENGINE_ANTHROPIC_API_VERSION=2023-06-01
NOVEL_ENGINE_MOONSHOT_API_KEY=
NOVEL_ENGINE_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
